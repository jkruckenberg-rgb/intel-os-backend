# INTEL·OS Backend — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub — it contains secrets

# SAM.gov API Key (from api.sam.gov)
SAM_API_KEY=your_sam_gov_api_key_here

# Email notification address
NOTIFY_EMAIL=jkruckenberg@jkconsultsllc.com

# SMTP settings for sending email alerts
# Option 1: Gmail (see README for setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password

# From address on outgoing emails
FROM_EMAIL=intel-os@jkconsultsllc.com

# Port (Railway sets this automatically)
PORT=3001
